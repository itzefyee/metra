# Used by the normal local-development loop: `npx convex dev` + `npm run dev`.
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud

# Keep server-side provider credentials in Convex deployment settings, never in
# NEXT_PUBLIC_* variables or committed local env files:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=your-chat-deployment
# ZOO_DEV_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
